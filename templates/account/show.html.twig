{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <div class="profile">
        <h1>Mon profil</h1>

        {% if user.imageName %}
            <img src="{{ vich_uploader_asset(user, 'imageFile') }}" alt="Photo de profil" class="profile-image">
        {% endif %}

        <p><strong>Prénom :</strong> {{ user.firstname }}</p>
        <p><strong>Nom :</strong> {{ user.lastname }}</p>
        <p><strong>Inscrit le :</strong> {{ user.createdAt|date('d/m/Y') }}</p>

        <a href="{{ path('app_account_edit') }}" class="btn">Modifier mon profil</a>
    </div>
{% endblock %}